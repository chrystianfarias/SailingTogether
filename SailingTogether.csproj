<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SailingTogether</AssemblyName>
    <RootNamespace>SailingTogether</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Valheim install path. Override with: dotnet build -p:GamePath="..." -->
    <GamePath Condition="'$(GamePath)' == ''">F:\SteamLibrary\steamapps\common\Valheim</GamePath>
    <ManagedPath>$(GamePath)\valheim_Data\Managed</ManagedPath>
    <BepInExPath>$(GamePath)\BepInEx</BepInExPath>
    <!-- Copies the DLL to BepInEx\plugins after the build -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>

    <!-- Release: must match SailingTogetherPlugin.ModVersion (checked by the Package target) -->
    <Version>1.0.0</Version>
    <RepoUrl>https://github.com/chrystianfarias/SailingTogether</RepoUrl>
    <BepInExPackDependency>denikson-BepInExPack_Valheim-5.4.2351</BepInExPackDependency>
    <ThunderstoreDescription>Cooperative rowing: players seated on ship benches row with W/S. Each side pushes independently, so the crew can steer and spin the ship. Includes a top-down ship HUD.</ThunderstoreDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ManagedPath)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ManagedPath)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(BepInExPath)\plugins\SailingTogether" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPath)\plugins\SailingTogether" />
    <Message Importance="high" Text="SailingTogether -> $(BepInExPath)\plugins\SailingTogether" />
  </Target>

  <!--
    Release packages in dist\:
      SailingTogether-<ver>-thunderstore.zip  (Thunderstore / r2modman)
      SailingTogether-<ver>.zip               (GitHub Releases / Nexus Mods / manual)
    Uso: dotnet build -c Release -t:Package
  -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <PluginSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\src\SailingTogetherPlugin.cs'))</PluginSource>
      <StagingDir>$(BaseIntermediateOutputPath)package\</StagingDir>
      <TsDir>$(StagingDir)thunderstore\</TsDir>
      <ManualDir>$(StagingDir)manual\</ManualDir>
      <DistDir>$(MSBuildProjectDirectory)\dist\</DistDir>
      <RawBase>$(RepoUrl.Replace('https://github.com/', 'https://raw.githubusercontent.com/'))/main</RawBase>
      <!-- Thunderstore does not resolve relative links in the README -->
      <TsReadme>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\README.md').Replace('](docs/', ']($(RawBase)/docs/').Replace('](LICENSE)', ']($(RepoUrl)/blob/main/LICENSE)').Replace('](#multiplayer)', ']($(RepoUrl)#multiplayer)'))</TsReadme>
    </PropertyGroup>

    <Error Condition="!$(PluginSource.Contains('ModVersion = &quot;$(Version)&quot;'))"
           Text="Version mismatch: the csproj says $(Version) but SailingTogetherPlugin.ModVersion differs." />

    <RemoveDir Directories="$(StagingDir)" />
    <MakeDir Directories="$(TsDir)plugins;$(ManualDir)BepInEx\plugins\SailingTogether;$(DistDir)" />

    <!-- Thunderstore -->
    <WriteLinesToFile File="$(TsDir)manifest.json" Overwrite="true" Lines="{;
  &quot;name&quot;: &quot;$(AssemblyName)&quot;,;
  &quot;version_number&quot;: &quot;$(Version)&quot;,;
  &quot;website_url&quot;: &quot;$(RepoUrl)&quot;,;
  &quot;description&quot;: &quot;$(ThunderstoreDescription)&quot;,;
  &quot;dependencies&quot;: [ &quot;$(BepInExPackDependency)&quot; ];
}" />
    <WriteLinesToFile File="$(TsDir)README.md" Overwrite="true" Lines="$([MSBuild]::Escape($(TsReadme)))" />
    <Copy SourceFiles="package\icon.png;CHANGELOG.md;LICENSE" DestinationFolder="$(TsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TsDir)plugins" />

    <!-- Manual / GitHub / Nexus -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ManualDir)BepInEx\plugins\SailingTogether" />
    <Copy SourceFiles="README.md;CHANGELOG.md;LICENSE" DestinationFolder="$(ManualDir)BepInEx\plugins\SailingTogether" />

    <Delete Files="$(DistDir)$(AssemblyName)-$(Version)-thunderstore.zip;$(DistDir)$(AssemblyName)-$(Version).zip" />
    <ZipDirectory SourceDirectory="$(TsDir)" DestinationFile="$(DistDir)$(AssemblyName)-$(Version)-thunderstore.zip" />
    <ZipDirectory SourceDirectory="$(ManualDir)" DestinationFile="$(DistDir)$(AssemblyName)-$(Version).zip" />
    <Message Importance="high" Text="Packages written to $(DistDir)" />
  </Target>

</Project>
